# Discord bot token. Required only if running the Discord interface
# (python main.py --discord). Never commit a real token.
DISCORD_TOKEN=

# Prefix for Discord bot commands (default: !)
DISCORD_COMMAND_PREFIX=!

# Optional default target URL/site for tasks that don't specify one.
TARGET_URL=

# Search engine URL template used for generic web-search tasks.
# Must contain a {query} placeholder.
DEFAULT_SEARCH_URL=https://duckduckgo.com/html/?q={query}

# Path to the SQLite database file used for persistent task memory.
DATABASE_PATH=data/taskhelper.db

# --- Browser configuration -------------------------------------------------

# "local" launches Chromium on this machine (must be pre-installed via
# `playwright install chromium`). "remote" connects to an existing
# Playwright-compatible browser server via BROWSER_WS_ENDPOINT.
BROWSER_MODE=local

# WebSocket endpoint of a remote Playwright/Chromium server.
# Required only when BROWSER_MODE=remote.
BROWSER_WS_ENDPOINT=

# Optional explicit path to a Chromium executable (useful when the browser
# was installed to a non-default location, e.g. in a container).
PLAYWRIGHT_EXECUTABLE_PATH=

# Run the browser headless (true/false). Keep true on servers.
HEADLESS=true

VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
USER_AGENT=

NAVIGATION_TIMEOUT_MS=20000
ACTION_TIMEOUT_MS=10000
MAX_RETRIES=3

# --- Logging ----------------------------------------------------------------

LOG_LEVEL=INFO
