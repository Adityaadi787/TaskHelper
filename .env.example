# Required only for Discord mode
DISCORD_TOKEN=
DISCORD_COMMAND_PREFIX=!

# Optional browser/search configuration
DEFAULT_SEARCH_URL=https://duckduckgo.com/html/?q={query}
TARGET_URL=
DATABASE_PATH=data/taskhelper.db
LOG_LEVEL=INFO

# local = installed Chromium; remote = Playwright browser WebSocket endpoint
BROWSER_MODE=local
BROWSER_WS_ENDPOINT=
PLAYWRIGHT_EXECUTABLE_PATH=
HEADLESS=true
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
USER_AGENT=
NAVIGATION_TIMEOUT_MS=20000
ACTION_TIMEOUT_MS=10000
MAX_RETRIES=3
INTERACTION_DELAY_MS=0
MAX_SEARCH_RESULTS=10
MAX_PAGES=5
MEMORY_MAX_AGE_HOURS=24
